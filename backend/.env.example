# Gemini API Key
GENAI_API_KEY=your_api_key_here

# Email addresses for routing issues
EMAIL_HARDWARE=hardware@example.com
EMAIL_SOFTWARE=software@example.com
EMAIL_NETWORK1=network1@example.com
EMAIL_NETWORK2=network2@example.com

# Email account for sending tickets
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword